{
  "expo": {
    "name": "Summar-Eeze",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.projectdigest.lz3y9s",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tag daily reports with job site location.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Tag daily reports with job site location.",
        "NSMicrophoneUsageDescription": "Dictate report highlights hands-free.",
        "NSCameraUsageDescription": "Snap job-site photos for daily reports.",
        "NSPhotoLibraryUsageDescription": "Attach photos to daily reports."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.projectdigest.lz3y9s",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECORD_AUDIO",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Tag daily reports with job site location."
        }
      ],
      "@react-native-vector-icons/ionicons",
      [
        "expo-audio",
        {
          "microphonePermission": "Dictate report highlights hands-free while driving."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach job-site photos to daily reports.",
          "cameraPermission": "Snap job-site photos for daily reports."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
